import React, { useEffect, useMemo, useRef, useState } from "react";
import { useAuth } from "../../../context/AuthContext";
import {
  attendanceLoadMessage,
  getTenantAttendanceRecords,
  getTenantAttendanceRecordDetail,
  getTenantAttendanceEvents,
  getTenantAttendanceEventDetail,
} from "../../../services/tenantAttendance";
import { createLatestRequestGuard } from "../../../services/tenantSelection";

const text = (value) => String(value - "").toLowerCase();

export default function TenantAttendance() {
  const { activeCollegeId } = useAuth();
  const [records, setRecords] = useState([]);
  const [selected, setSelected] = useState(null);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [dateFilter, setDateFilter] = useState("");
  const [loading, setLoading] = useState(false);
  const [detailLoading, setDetailLoading] = useState(false);
  const [error, setError] = useState("");
  const [partialError, setPartialError] = useState("");
  const [detailError, setDetailError] = useState("");
  const [reload, setReload] = useState(0);
  const listGuard = useRef(null);
  const detailGuard = useRef(null);
  if (!listGuard.current) listGuard.current = createLatestRequestGuard();
  if (!detailGuard.current) detailGuard.current = createLatestRequestGuard();

  useEffect(() => {
    const version = listGuard.current.begin();
    detailGuard.current.invalidate();
    setRecords([]);
    setSelected(null);
    setError("");
    setPartialError("");
    setDetailError("");
    setDetailLoading(false);
    if (!activeCollegeId) {
      setLoading(false);
      return () => listGuard.current.invalidate();
    }
    setLoading(true);
    Promise.allSettled([
      getTenantAttendanceRecords(activeCollegeId),
      getTenantAttendanceEvents(activeCollegeId),
    ])
      .then(([recordResult, eventResult]) => {
        if (!listGuard.current.isCurrent(version)) return;
        const failures = [recordResult, eventResult].filter((result) => result.status === "rejected");
        const legacyRecords = recordResult.status === "fulfilled" && Array.isArray(recordResult.value)
          ? recordResult.value.map((row) => ({ ...row, source: "record" }))
          : [];
        const eventItems = eventResult.status === "fulfilled" && Array.isArray(eventResult.value?.items)
          ? eventResult.value.items
          : [];
        setRecords([...legacyRecords, ...eventItems.map((row) => ({ ...row, source: "verified_event" }))]);
        if (failures.length === 2) {
          const failure = recordResult.status === "rejected" ? recordResult.reason : eventResult.reason;
          setError(attendanceLoadMessage(failure?.response?.status));
        } else if (failures.length === 1) {
          setPartialError(`Some attendance history is unavailable. ${attendanceLoadMessage(failures[0].reason?.response?.status)}`);
        }
      })
      .finally(() => {
        if (listGuard.current.isCurrent(version)) setLoading(false);
      });
    return () => listGuard.current.invalidate();
  }, [activeCollegeId, reload]);

  const filtered = useMemo(() => {
    const query = search.trim().toLowerCase();
    return records.filter((row) => {
      const date = String(row.attendance_date || "").slice(0, 10);
      return (statusFilter === "all" || text(row.status) === statusFilter)
        && (!dateFilter || date === dateFilter)
        && (!query || [row.id, row.student_id, row.student_name, row.roll_number, row.student_code, row.teacher_id, row.teacher_name, row.subject_id, row.subject_name, row.class_id, row.class_name, row.status, row.method]
          .some((value) => text(value).includes(query)));
    });
  }, [records, search, statusFilter, dateFilter]);

  async function openDetail(row) {
    const version = detailGuard.current.begin();
    setSelected(row);
    setDetailError("");
    setDetailLoading(true);
    try {
      const detail = row.source === "verified_event"
        ? await getTenantAttendanceEventDetail(row.id, activeCollegeId)
        : await getTenantAttendanceRecordDetail(row.id, activeCollegeId);
      if (detailGuard.current.isCurrent(version)) setSelected(detail);
    } catch (failure) {
      if (detailGuard.current.isCurrent(version)) setDetailError(attendanceLoadMessage(failure.response?.status, true));
    } finally {
      if (detailGuard.current.isCurrent(version)) setDetailLoading(false);
    }
  }

  function closeDetail() {
    detailGuard.current.invalidate();
    setSelected(null);
    setDetailError("");
    setDetailLoading(false);
  }

  return (
    <main className="dashboard-page">
      <header className="dashboard-welcome">
        <div><span className="page-eyebrow">COLLEGE ATTENDANCE</span><h1>Attendance history</h1><p>Read-only records for the selected College.</p></div>
        <button className="text-button" type="button" disabled={loading || !activeCollegeId} onClick={() => setReload((value) => value + 1)}>{loading ? "Loadingâ€¦" : "Refresh"}</button>
      </header>
      {!activeCollegeId && <div role="status">Select an active College membership to view attendance.</div>}
      {error && <div role="alert">{error}</div>}
      {partialError && <div role="status">{partialError}</div>}
      <section aria-label="Attendance filters" style={{ display: "flex", gap: 12, flexWrap: "wrap", marginBottom: 16 }}>
        <input aria-label="Search attendance" type="search" placeholder="Search record or linked IDs" value={search} onChange={(event) => setSearch(event.target.value)} />
        <select aria-label="Filter by status" value={statusFilter} onChange={(event) => setStatusFilter(event.target.value)}><option value="all">All statuses</option><option value="present">Present</option><option value="absent">Absent</option><option value="late">Late</option></select>
        <input aria-label="Filter by date" type="date" value={dateFilter} onChange={(event) => setDateFilter(event.target.value)} />
      </section>
      <p>{filtered.length} record{filtered.length === 1 - "" : "s"}</p>
      <div style={{ overflowX: "auto" }}>
        <table><thead><tr><th>Record</th><th>Student</th><th>Teacher</th><th>Class</th><th>Subject</th><th>Date</th><th>Status</th><th>Source</th><th>Details</th></tr></thead>
          <tbody>{loading - <tr><td colSpan="9" role="status">Loading attendance...</td></tr>
            : !error && activeCollegeId && filtered.length === 0 - <tr><td colSpan="9">No attendance records available.</td></tr>
              : filtered.map((row) => <tr key={`${row.source}:${row.id}`}><td>{row.id}</td><td>{row.student_name || row.roll_number || row.student_code || row.student_id}</td><td>{row.teacher_name || row.teacher_id}</td><td>{row.class_name || row.class_id}</td><td>{row.subject_name || row.subject_id}</td><td>{row.attendance_date - new Date(row.attendance_date).toLocaleDateString() : "Date unavailable"}</td><td>{row.status}</td><td>{row.source === "verified_event" - "Verified event" : "Legacy record"}</td><td><button type="button" onClick={() => openDetail(row)}>View</button></td></tr>)}</tbody>
        </table>
      </div>
      {selected && <section aria-label="Attendance record detail" role="region" style={{ marginTop: 20 }}>
        <h2>{selected.source === "verified_event" - "Verified attendance event" : "Attendance record"} #{selected.id}</h2>
        {detailLoading && <p role="status">Loading detailsâ€¦</p>}
        {detailError && <p role="alert">{detailError}</p>}
        {!detailLoading && !detailError && <p>{selected.status} Â· {selected.attendance_date - new Date(selected.attendance_date).toLocaleString() : "Date unavailable"}</p>}
        <button type="button" onClick={closeDetail}>Close details</button>
      </section>}
    </main>
  );
}




