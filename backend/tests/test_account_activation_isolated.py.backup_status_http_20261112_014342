    def test_expired_pending_invitation_can_be_renewed_safely(self):
        created = self.create_legacy_pending_invitation(email="renew-expired@example.com", roll="ACT-RENEW")
        self.assertEqual(created.status_code, 201, created.text)
        student_id = created.json()["id"]
        old_token = self.activation_token(self.sent[-1])
        with self.Session.begin() as db:
            invitation = db.query(AccountInvitation).one()
            invitation.expires_at = datetime.now(timezone.utc) - timedelta(seconds=1)
        status_response = self.client.get(f"/students/{student_id}/invitation?college_id=8101", headers=self.admin_headers())
        self.assertEqual(status_response.status_code, 200, status_response.text)
        self.assertEqual(status_response.json()["status"], "expired")
        self.assertTrue(status_response.json()["can_resend"])
        resent = self.client.post(f"/students/{student_id}/invitation/resend?college_id=8101", headers=self.admin_headers())
        self.assertEqual(resent.status_code, 200, resent.text)
        new_token = self.activation_token(self.sent[-1])
        self.assertNotEqual(old_token, new_token)
        with self.Session() as db:
            invitations = db.query(AccountInvitation).order_by(AccountInvitation.id).all()
            self.assertEqual(len(invitations), 2)
            self.assertIsNotNone(invitations[0].revoked_at)
            self.assertIsNone(invitations[1].revoked_at)
        stale = self.client.post("/account-activation/complete", json={"token": old_token, "password": "Synthet!c-Activation-2026"})
        self.assertEqual(stale.status_code, 400)
        current = self.client.post("/account-activation/complete", json={"token": new_token, "password": "Synthet!c-Activation-2026"})
        self.assertEqual(current.status_code, 200, current.text)

    def test_smtp_failure_keeps_account_pending_and_never_returns_credentials(self):
        self.delivery_patch.stop()
        failing = patch("app.services.account_activation._deliver_email", side_effect=RuntimeError("synthetic delivery failure"))
        failing.start()
        try:
            response = self.create_legacy_pending_invitation(email="failed-delivery@example.com", roll="ACT-FAIL")
            self.assertEqual(response.status_code, 201, response.text)
            self.assertEqual(response.json()["invitation_status"], "not_required")
            self.assertNotIn("token", response.text.lower())
            with self.Session() as db:
                user = db.query(User).filter_by(email="failed-delivery@example.com").one()
                self.assertFalse(user.is_active)
                self.assertFalse(db.query(Student).filter_by(email=user.email).one().is_active)
                self.assertEqual(db.query(AccountInvitation).one().delivery_status, "failed")
        finally:
            failing.stop()
            self.delivery_patch.start()

