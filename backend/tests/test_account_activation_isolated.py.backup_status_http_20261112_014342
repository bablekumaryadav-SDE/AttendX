        with patch.dict(os.environ, SMTP_ENV):
            os.environ.pop("ATTENDX_PUBLIC_URL", None)
            response = self.create_legacy_pending_invitation(email="no-mail@example.com", roll="ACT-NOMAIL")
        self.assertEqual(response.status_code, 201, response.text)
        self.assertEqual(response.json()["invitation_status"], "not_required")
        with self.Session() as db:
            user = db.query(User).filter_by(email="no-mail@example.com").one()
            membership = db.query(CollegeMembership).filter_by(user_id=user.id).one()
            self.assertFalse(user.is_active)
            self.assertEqual(membership.status, "pending")
            self.assertEqual(db.query(AccountInvitation).count(), 0)

    def test_foreign_college_admin_cannot_read_or_resend_student_invitation(self):
        created = self.create_legacy_pending_invitation(email="college-a-student@example.com", roll="ACT-A")
        student_id = created.json()["id"]
        with self.Session.begin() as db:
            db.add_all([
                User(id=8202, name="College B admin", email="activation-admin-b@example.com", hashed_password="synthetic", role="admin"),
                College(id=8202, slug="activation-b", official_name="Activation B", status="active"),
            ])
            db.flush()
            db.add(CollegeMembership(user_id=8202, college_id=8202, role="college_admin", status="active"))
        headers_b = {"Authorization": f"Bearer {create_access_token({'sub': 'activation-admin-b@example.com'})}"}
        status_response = self.client.get(f"/students/{student_id}/invitation?college_id=8202", headers=headers_b)
        resend_response = self.client.post(f"/students/{student_id}/invitation/resend?college_id=8202", headers=headers_b)
        self.assertEqual(status_response.status_code, 404)
        self.assertEqual(resend_response.status_code, 404)
        self.assertNotIn("college-a-student@example.com", status_response.text + resend_response.text)
        self.assertNotIn("token_digest", status_response.text + resend_response.text)

    def test_invitation_model_and_draft_enforce_digest_and_same_membership_identity(self):
        table = AccountInvitation.__table__
        self.assertIn("token_digest", table.c)
        self.assertNotIn("token", table.c)
        composite = [constraint for constraint in table.foreign_key_constraints if len(constraint.elements) == 3]
        self.assertEqual(len(composite), 1)
        self.assertEqual(
            [element.target_fullname for element in composite[0].elements],
            ["college_memberships.id", "college_memberships.user_id", "college_memberships.college_id"],
        )
        draft = Path(__file__).resolve().parents[2] / "database" / "migrations" / "DRAFT_20261112_account_activation_invitations.sql"
        sql = draft.read_text(encoding="utf-8").lower()
        self.assertIn("status: draft / not applied", sql)
        self.assertIn("token_digest varchar(64) not null unique", sql)
        self.assertIn("on delete restrict", sql)
        self.assertNotRegex(sql, r"\b(insert|update|delete)\s+into?\s+public\.(users|students|teachers|college_memberships)\b")


