"""Face enrollment API validation tests with isolated user/student records."""
import hashlib
import unittest
from unittest.mock import patch

import cv2
import numpy as np
from fastapi.testclient import TestClient
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker
from sqlalchemy.pool import StaticPool

from app.database import Base, get_db
from app.dependencies import get_current_user
from app.main import app
from app.models import FaceEmbedding, Student, User


class FaceApiIsolationTests(unittest.TestCase):
    def setUp(self):
        self.engine = create_engine(
            "sqlite://",
            connect_args={"check_same_thread": False},
            poolclass=StaticPool,
        )
        Base.metadata.create_all(self.engine)
        self.Session = sessionmaker(bind=self.engine, expire_on_commit=False)
        with self.Session.begin() as session:
            session.add_all([
                User(id=30, name="Fixture Student", email="face@example.org", hashed_password="x", role="student"),
                Student(id=40, student_code="S-FACE-40", name="Fixture Student",
                        email="face@example.org", roll_number="F-40", is_active=True),
                Student(id=41, student_code="S-FACE-41", name="Other Student",
                        email="other-face@example.org", roll_number="F-41", is_active=True),
            ])
        self.actor = {"sub": "30", "id": 30, "email": "face@example.org", "role": "student", "is_active": True}

        def override_db():
            with self.Session() as session:
                yield session

        app.dependency_overrides.clear()
        app.dependency_overrides[get_db] = override_db
        app.dependency_overrides[get_current_user] = lambda: self.actor
        self.client = TestClient(app)

    def tearDown(self):
        self.client.close()
        app.dependency_overrides.clear()
        self.engine.dispose()

    def test_corrupt_image_is_rejected_and_registration_stays_false(self):
        before = self.client.get("/face/me/status")
        self.assertEqual(before.status_code, 200, before.text)
        self.assertFalse(before.json()["face_registered"])

        response = self.client.post(
            "/face/me/register",
            files={"file": ("corrupt.jpg", b"not a valid image", "image/jpeg")},
        )
        self.assertEqual(response.status_code, 422, response.text)

        after = self.client.get("/face/me/status")
        self.assertEqual(after.status_code, 200, after.text)
        self.assertFalse(after.json()["face_registered"])
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_admin_face_registration_rejects_unsupported_type_and_oversized_upload(self):
        self.actor["role"] = "admin"
        unsupported = self.client.post(
            "/students/40/face",
            files={"file": ("face.gif", b"GIF89a", "image/gif")},
            data={"consent": "true"},
        )
        self.assertEqual(unsupported.status_code, 415, unsupported.text)

        oversized = self.client.post(
            "/students/40/face",
            files={"file": ("large.png", b"\x89PNG\r\n\x1a\n" + b"x" * (5 * 1024 * 1024), "image/png")},
            data={"consent": "true"},
        )
        self.assertEqual(oversized.status_code, 413, oversized.text)
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_admin_face_registration_rejects_corrupt_image_signature(self):
        self.actor["role"] = "admin"
        response = self.client.post(
            "/students/40/face",
            files={"file": ("corrupt.jpg", b"not an image", "image/jpeg")},
            data={"consent": "true"},
        )
        self.assertEqual(response.status_code, 400, response.text)
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_real_model_rejects_blank_no_face_image_without_persisting(self):
        self.actor["role"] = "admin"
        encoded, image = cv2.imencode(".png", np.zeros((320, 320, 3), dtype=np.uint8))
        self.assertTrue(encoded)
        response = self.client.post(
            "/students/40/face",
            files={"file": ("blank.png", image.tobytes(), "image/png")},
            data={"consent": "true"},
        )
        self.assertEqual(response.status_code, 422, response.text)
        self.assertIn("No face detected", response.json()["detail"])
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_multiple_face_detection_branch_rejects_image(self):
        self.actor["role"] = "admin"
        encoded, image = cv2.imencode(".png", np.zeros((320, 320, 3), dtype=np.uint8))
        self.assertTrue(encoded)

        class TwoFaceDetector:
            def setInputSize(self, size):
                self.size = size

            def detect(self, frame):
                return 1, np.zeros((2, 15), dtype=np.float32)

        with patch("app.services.face_engine._models", return_value=(TwoFaceDetector(), object())):
            response = self.client.post(
                "/students/40/face",
                files={"file": ("two-faces.png", image.tobytes(), "image/png")},
                data={"consent": "true"},
            )

        self.assertEqual(response.status_code, 422, response.text)
        self.assertIn("Multiple faces detected", response.json()["detail"])
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_duplicate_image_for_another_student_is_rejected_before_recognition(self):
        self.actor["role"] = "admin"
        image = b"\x89PNG\r\n\x1a\nfixture-duplicate-image"
        with self.Session.begin() as session:
            session.add(FaceEmbedding(
                student_id=41,
                image_data=image,
                mime_type="image/png",
                image_sha256=hashlib.sha256(image).hexdigest(),
                embedding_json="[]",
                status="registered",
            ))

        with patch("app.api.students.embedding_from_image", side_effect=AssertionError("recognition should not run for a duplicate image")) as recognize:
            response = self.client.post(
                "/students/40/face",
                files={"file": ("duplicate.png", image, "image/png")},
                data={"consent": "true"},
            )

        self.assertEqual(response.status_code, 409, response.text)
        recognize.assert_not_called()
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 1)

    def test_unauthenticated_admin_face_registration_is_rejected(self):
        app.dependency_overrides.pop(get_current_user)
        response = self.client.post(
            "/students/40/face",
            files={"file": ("face.png", b"\x89PNG\r\n\x1a\n", "image/png")},
            data={"consent": "true"},
        )
        self.assertEqual(response.status_code, 401, response.text)
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_student_cannot_register_a_different_students_face_through_admin_route(self):
        response = self.client.post(
            "/students/40/face",
            files={"file": ("corrupt.jpg", b"not a valid image", "image/jpeg")},
            data={"consent": "true"},
        )
        self.assertEqual(response.status_code, 403)
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_admin_face_registration_requires_explicit_consent(self):
        self.actor["role"] = "admin"
        image = {"file": ("corrupt.jpg", b"not a valid image", "image/jpeg")}

        missing = self.client.post("/students/40/face", files=image)
        self.assertEqual(missing.status_code, 422, missing.text)

        declined = self.client.post(
            "/students/40/face",
            files=image,
            data={"consent": "false"},
        )
        self.assertEqual(declined.status_code, 400, declined.text)
        self.assertIn("consent is required", declined.json()["detail"].lower())
        with self.Session() as session:
            self.assertEqual(session.query(FaceEmbedding).count(), 0)

    def test_admin_face_registration_persists_only_after_consent_and_confirms_status(self):
        self.actor["role"] = "admin"
        image = b"\x89PNG\r\n\x1a\nfixture-image-bytes"
        embedding = [1.0] + [0.0] * 127
        with patch("app.api.students.embedding_from_image", return_value=embedding):
            response = self.client.post(
                "/students/40/face",
                files={"file": ("consented.png", image, "image/png")},
                data={"consent": "true"},
            )

        self.assertEqual(response.status_code, 200, response.text)
        self.assertTrue(response.json()["face_registered"])
        with self.Session() as session:
            registration = session.query(FaceEmbedding).one()
            self.assertEqual(registration.student_id, 40)
            self.assertEqual(registration.image_data, image)
            self.assertEqual(registration.status, "registered")


if __name__ == "__main__":
    unittest.main()
