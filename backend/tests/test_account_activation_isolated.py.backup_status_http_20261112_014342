"""Account activation behavior tests using synthetic in-memory SQLite and mocked SMTP."""

import os
import unittest
from datetime import datetime, timedelta, timezone
from unittest.mock import patch

from fastapi.testclient import TestClient
from sqlalchemy import create_engine, event
from sqlalchemy.orm import sessionmaker
from sqlalchemy.pool import StaticPool

from app.database import Base, get_db
from app.main import app
from app.models import AccountInvitation, College, CollegeMembership, Student, Teacher, User
from app.security import create_access_token, verify_password
from pathlib import Path


SMTP_ENV = {
    "ATTENDX_ACTIVATION_SMTP_HOST": "smtp.example.invalid",
    "ATTENDX_ACTIVATION_SMTP_PORT": "587",
    "ATTENDX_ACTIVATION_SMTP_USERNAME": "synthetic-user",
    "ATTENDX_ACTIVATION_SMTP_PASSWORD": "synthetic-mail-password",
    "ATTENDX_ACTIVATION_FROM_EMAIL": "no-reply@example.invalid",
    "ATTENDX_PUBLIC_URL": "https://attendx.example.invalid",
}


class AccountActivationTests(unittest.TestCase):
    def setUp(self):
        self.engine = create_engine("sqlite://", connect_args={"check_same_thread": False}, poolclass=StaticPool)

        @event.listens_for(self.engine, "connect")
        def _enable_sqlite_fks(connection, _record):
            cursor = connection.cursor()
            cursor.execute("PRAGMA foreign_keys=ON")
            cursor.close()

        Base.metadata.create_all(self.engine)
        self.Session = sessionmaker(bind=self.engine, expire_on_commit=False)
        with self.Session.begin() as db:
            db.add_all([
                User(id=8101, name="Synthetic College Admin", email="activation-admin@example.com", hashed_password="synthetic", role="admin"),
                College(id=8101, slug="activation-a", official_name="Activation A", status="active"),
            ])
            db.flush()
            db.add(CollegeMembership(user_id=8101, college_id=8101, role="college_admin", status="active"))

        def override_db():
            with self.Session() as db:
                yield db

        app.dependency_overrides.clear()
        app.dependency_overrides[get_db] = override_db
        self.client = TestClient(app)
        self.sent = []
        self.smtp_patch = patch.dict(os.environ, SMTP_ENV)
        self.smtp_patch.start()
        self.delivery_patch = patch("app.services.account_activation._deliver_email", side_effect=self._capture_email)
        self.delivery_patch.start()

    def tearDown(self):
        self.delivery_patch.stop()
        self.smtp_patch.stop()
        self.client.close()
        app.dependency_overrides.clear()
        self.engine.dispose()

    def _capture_email(self, host, port, username, password, sender, recipient, activation_url):
        self.sent.append({"recipient": recipient, "url": activation_url})

    @staticmethod
    def admin_headers():
        return {"Authorization": f"Bearer {create_access_token({'sub': 'activation-admin@example.com'})}"}

    @staticmethod
    def activation_token(message):
        return message["url"].split("#token=", 1)[1]

    def register_student(self, email="new-activation-student@example.com", roll="ACT-1"):
        return self.client.post("/students/?college_id=8101", headers=self.admin_headers(), json={
            "name": "Activation Student", "email": email, "roll_number": roll,
            "password": "Synthet!c-Activation-2026", "password_confirmation": "Synthet!c-Activation-2026",
        })

    def create_legacy_pending_invitation(self, email="legacy-student@example.com", roll="ACT-LEGACY"):
        """Represent an account created by the older invitation-based workflow."""
        response = self.register_student(email=email, roll=roll)
        if response.status_code != 201:
            return response
        with self.Session.begin() as db:
            user = db.query(User).filter_by(email=email).one()
            student = db.query(Student).filter_by(email=email).one()
            membership = db.query(CollegeMembership).filter_by(user_id=user.id, college_id=8101).one()
            user.is_active = False
            student.is_active = False
            membership.status = "pending"
            membership.activated_by_user_id = None
            membership.activated_at = None
            membership.status_reason = "Synthetic legacy pending invitation fixture."
        with self.Session() as db:
            user = db.query(User).filter_by(email=email).one()
            membership = db.query(CollegeMembership).filter_by(user_id=user.id, college_id=8101).one()
            from app.services.account_activation import issue_invitation
            issue_invitation(db, user=user, membership=membership, actor_user_id=8101)
        return response

    def test_student_registration_uses_admin_set_permanent_password_for_immediate_login(self):
        response = self.register_student()
        self.assertEqual(response.status_code, 201, response.text)
        body = response.json()
        self.assertEqual(body["account_activation"], "active")
        self.assertEqual(body["invitation_status"], "not_required")
        with self.Session() as db:
            self.assertEqual(db.query(AccountInvitation).count(), 0)
            user = db.query(User).filter_by(email="new-activation-student@example.com").one()
            self.assertTrue(user.is_active)
            self.assertTrue(db.query(Student).filter_by(email=user.email).one().is_active)
            self.assertTrue(verify_password("Synthet!c-Activation-2026", user.hashed_password))
        login = self.client.post("/auth/login", json={"email": "new-activation-student@example.com", "password": "Synthet!c-Activation-2026"})
        self.assertEqual(login.status_code, 200, login.text)
        self.assertNotIn("Synthet!c-Activation-2026", response.text + login.text)

    def test_teacher_registration_and_activation_activate_membership_and_profile_together(self):
        response = self.client.post("/teachers/?college_id=8101", headers=self.admin_headers(), json={
            "name": "Activation Teacher", "email": "new-activation-teacher@example.com",
            "password": "Teach3r!Synthetic-Setup", "password_confirmation": "Teach3r!Synthetic-Setup",
        })
        self.assertEqual(response.status_code, 201, response.text)
        self.assertTrue(response.json()["employee_id"])
        self.assertEqual(response.json()["invitation_status"], "not_required")
        login = self.client.post("/auth/login", json={"email": "new-activation-teacher@example.com", "password": "Teach3r!Synthetic-Setup"})
        self.assertEqual(login.status_code, 200, login.text)
        self.assertNotIn("Teach3r!Synthetic-Setup", response.text + login.text)
        with self.Session() as db:
            user = db.query(User).filter_by(email="new-activation-teacher@example.com").one()
            teacher = db.query(Teacher).filter_by(email=user.email).one()
            membership = db.query(CollegeMembership).filter_by(user_id=user.id).one()
            self.assertTrue(user.is_active and teacher.is_active)
            self.assertEqual(membership.status, "active")

    def test_invalid_password_token_expiry_and_single_use_fail_closed(self):
        created = self.create_legacy_pending_invitation(email="expired-student@example.com", roll="ACT-EXP")
        token = self.activation_token(self.sent[-1])
        weak = self.client.post("/account-activation/complete", json={"token": token, "password": "weak"})
        self.assertEqual(weak.status_code, 400)
        self.assertNotIn(token, weak.text)
        with self.Session.begin() as db:
            invite = db.query(AccountInvitation).one()
            invite.expires_at = datetime.now(timezone.utc) - timedelta(seconds=1)
        expired = self.client.post("/account-activation/complete", json={"token": token, "password": "Synthet!c-Activation-2026"})
        self.assertEqual(expired.status_code, 400)
        self.assertEqual(expired.json()["detail"], "This activation link is invalid, expired, or already used. Request a new invitation.")
        self.assertEqual(created.status_code, 201)

    def test_invitation_lifetime_is_configurable_and_bounded(self):
        with patch.dict(os.environ, {**SMTP_ENV, "ATTENDX_ACTIVATION_TTL_HOURS": "48"}):
            self.create_legacy_pending_invitation(email="ttl-student@example.com", roll="ACT-TTL")
        with self.Session() as db:
            invitation = db.query(AccountInvitation).one()
            created_at = invitation.created_at
            if created_at.tzinfo is None:
                created_at = created_at.replace(tzinfo=timezone.utc)
            expires_at = invitation.expires_at
            if expires_at.tzinfo is None:
                expires_at = expires_at.replace(tzinfo=timezone.utc)
            self.assertAlmostEqual((expires_at - created_at).total_seconds(), 48 * 3600, delta=2)

    def test_resend_revokes_prior_token_and_status_never_returns_token(self):
        response = self.create_legacy_pending_invitation(email="resend-student@example.com", roll="ACT-RESEND")
        student_id = response.json()["id"]
        old_token = self.activation_token(self.sent[-1])
        status_response = self.client.get(f"/students/{student_id}/invitation?college_id=8101", headers=self.admin_headers())
        self.assertEqual(status_response.status_code, 200, status_response.text)
        self.assertEqual(status_response.json()["status"], "sent")
        self.assertTrue(status_response.json()["can_resend"])
        self.assertNotIn("token", status_response.text.lower())
        resent = self.client.post(f"/students/{student_id}/invitation/resend?college_id=8101", headers=self.admin_headers())
        self.assertEqual(resent.status_code, 200, resent.text)
        new_token = self.activation_token(self.sent[-1])
        self.assertNotEqual(old_token, new_token)
        repeated = self.client.post(f"/students/{student_id}/invitation/resend?college_id=8101", headers=self.admin_headers())
        self.assertEqual(repeated.status_code, 200, repeated.text)
        repeated_token = self.activation_token(self.sent[-1])
        self.assertNotEqual(new_token, repeated_token)
        with self.Session() as db:
            invitations = db.query(AccountInvitation).order_by(AccountInvitation.id).all()
            self.assertEqual(len(invitations), 3)
            self.assertEqual(sum(invitation.revoked_at is None and invitation.consumed_at is None for invitation in invitations), 1)
        old_result = self.client.post("/account-activation/complete", json={"token": old_token, "password": "Synthet!c-Activation-2026"})
        self.assertEqual(old_result.status_code, 400)
        superseded_result = self.client.post("/account-activation/complete", json={"token": new_token, "password": "Synthet!c-Activation-2026"})
        self.assertEqual(superseded_result.status_code, 400)
        new_result = self.client.post("/account-activation/complete", json={"token": repeated_token, "password": "Synthet!c-Activation-2026"})
        self.assertEqual(new_result.status_code, 200)

    def test_active_permanent_password_account_cannot_receive_an_invitation(self):
        created = self.register_student(email="active-invitation@example.com", roll="ACT-ACTIVE")
        self.assertEqual(created.status_code, 201, created.text)
        student_id = created.json()["id"]
        status_response = self.client.get(f"/students/{student_id}/invitation?college_id=8101", headers=self.admin_headers())
        self.assertEqual(status_response.status_code, 200, status_response.text)
        self.assertEqual(status_response.json()["status"], "activated")
        self.assertFalse(status_response.json()["can_resend"])
        self.assertEqual(status_response.json()["resend_blocked_reason"], "account_active")
        resent = self.client.post(f"/students/{student_id}/invitation/resend?college_id=8101", headers=self.admin_headers())
        self.assertEqual(resent.status_code, 409, resent.text)
        self.assertEqual(resent.json()["detail"]["code"], "account_already_active")
        self.assertIn("active account", resent.json()["detail"]["message"])
        self.assertEqual(self.sent, [])

