"""Guardian endpoint integration tests using in-memory SQLite only."""
import unittest

from fastapi.testclient import TestClient
from sqlalchemy import create_engine, text
from sqlalchemy.orm import sessionmaker
from sqlalchemy.pool import StaticPool

from app.database import Base, get_db
from app.dependencies import get_current_user
from app.main import app
from app.models import Student


class GuardianApiTests(unittest.TestCase):
    def setUp(self):
        self.engine = create_engine(
            "sqlite://",
            connect_args={"check_same_thread": False},
            poolclass=StaticPool,
        )
        Base.metadata.create_all(self.engine)
        with self.engine.begin() as connection:
            connection.exec_driver_sql("""
                CREATE TABLE student_guardians (
                    student_id INTEGER PRIMARY KEY REFERENCES students(id) ON DELETE CASCADE,
                    guardian_name VARCHAR(120) NOT NULL,
                    guardian_relationship VARCHAR(30) NOT NULL DEFAULT 'Father',
                    guardian_mobile VARCHAR(20) NOT NULL,
                    alternate_mobile VARCHAR(20),
                    notify_absence BOOLEAN NOT NULL DEFAULT TRUE,
                    notify_low_attendance BOOLEAN NOT NULL DEFAULT TRUE,
                    notification_channel VARCHAR(20) NOT NULL DEFAULT 'sms_email',
                    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
                    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
                )
            """)
            connection.exec_driver_sql("CREATE INDEX ix_student_guardians_mobile ON student_guardians (guardian_mobile)")
        self.Session = sessionmaker(bind=self.engine, expire_on_commit=False)
        with self.Session.begin() as session:
            session.add(Student(
                id=101,
                student_code="GUARD-101",
                name="Guardian Test Student",
                email="guardian-student@example.org",
                roll_number="GUARD-101",
                is_active=True,
            ))
        self.actor = {"sub": "900", "id": 900, "email": "admin@example.org", "role": "admin", "is_active": True}

        def override_db():
            with self.Session() as session:
                yield session

        app.dependency_overrides.clear()
        app.dependency_overrides[get_db] = override_db
        app.dependency_overrides[get_current_user] = lambda: self.actor
        self.client = TestClient(app)

    def tearDown(self):
        self.client.close()
        app.dependency_overrides.clear()
        self.engine.dispose()

    def test_admin_can_create_edit_reload_and_persist_guardian(self):
        path = "/students/101/guardian"
        original = {
            "guardian_name": "  Ananya   Sharma ",
            "guardian_relationship": "mother",
            "guardian_mobile": "98765-43210",
            "alternate_mobile": None,
        }
        saved = self.client.put(path, json=original)
        self.assertEqual(saved.status_code, 200, saved.text)
        self.assertEqual(saved.json()["guardian_name"], "Ananya Sharma")
        self.assertEqual(saved.json()["guardian_relationship"], "Mother")
        self.assertEqual(saved.json()["guardian_mobile"], "+919876543210")

        edited = self.client.put(path, json={
            "guardian_name": "Ravi Sharma",
            "guardian_relationship": "Brother",
            "guardian_mobile": "+1 (212) 555-0100",
            "notify_absence": False,
        })
        self.assertEqual(edited.status_code, 200, edited.text)
        self.assertEqual(edited.json()["guardian_name"], "Ravi Sharma")
        self.assertEqual(edited.json()["guardian_relationship"], "Brother")
        self.assertFalse(edited.json()["notify_absence"])

        reloaded = self.client.get(path)
        self.assertEqual(reloaded.status_code, 200, reloaded.text)
        self.assertEqual(reloaded.json()["guardian_mobile"], "+12125550100")
        with self.engine.connect() as connection:
            persisted = connection.execute(text("""
                SELECT guardian_name, guardian_relationship, guardian_mobile
                FROM student_guardians WHERE student_id = 101
            """)).one()
        self.assertEqual(tuple(persisted), ("Ravi Sharma", "Brother", "+12125550100"))

    def test_invalid_name_phone_relationship_and_missing_student_are_rejected(self):
        path = "/students/101/guardian"
        base = {"guardian_name": "Sam Parent", "guardian_relationship": "Father", "guardian_mobile": "9876543210"}
        for update in (
            {"guardian_name": "   "},
            {"guardian_mobile": "letters-only"},
            {"guardian_relationship": "Cousin"},
        ):
            with self.subTest(update=update):
                response = self.client.put(path, json={**base, **update})
                self.assertEqual(response.status_code, 422, response.text)
        missing = self.client.put("/students/999/guardian", json=base)
        self.assertEqual(missing.status_code, 404, missing.text)

    def test_only_admin_can_read_or_write_guardian_and_missing_auth_is_401(self):
        path = "/students/101/guardian"
        payload = {"guardian_name": "Sam Parent", "guardian_relationship": "Father", "guardian_mobile": "9876543210"}
        self.actor["role"] = "student"
        self.assertEqual(self.client.get(path).status_code, 403)
        self.assertEqual(self.client.put(path, json=payload).status_code, 403)

        app.dependency_overrides.pop(get_current_user)
        self.assertEqual(self.client.get(path).status_code, 401)


if __name__ == "__main__":
    unittest.main()
